@charset "utf-8";

html, body, header, section, nav, aside, footer, h1, h2, h3, h4 div, span, #header, #nav, #menu, #hiddenmenu, #footer, #maincontent, #wrapper { margin: 0px; padding: 0px; }

html { height: 100%; }

body { font-family: Arial, Helvetica, sans-serif; height: 100%; width: 100%; font-size: 10px; color: rgb(104, 104, 104); background: url("../images/bckgr.png") 0px 0px repeat; min-width: 320px; }

#maincontent { min-height: 90%; }

a { color: rgb(104, 104, 104); text-decoration: none; }

a:hover { color: rgb(255, 215, 97); }

#wrapper { width: 100%; height: 100%; }

#pageloadgif { position: fixed; width: 300px; height: 20px; top: 10px; left: 50%; margin-left: -152px; padding: 5px; background-color: rgb(255, 255, 255); z-index: 9999; border: 1px solid rgb(208, 208, 208); }

.container { width: 1200px; margin: auto; }

.fullcontainer { float: left; width: 100%; margin: 0px; padding: 0px; }

.halfcontainer { float: left; width: 50%; margin: auto; padding: 0px; }

.clearfix { zoom: 1; clear: both; display: block; height: 0px; font-size: 0px; }

.clearfix.left { clear: left; }

.clearfix.right { clear: right; }

.text-centred { text-align: center; }

.text-align-left { text-align: left; }

.text-align-right { text-align: right; }

.position-relative { position: relative; }

.opacity_50 { opacity: 0.5; }

.opacity_40 { opacity: 0.4; }

.mask { display: none; position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.5); z-index: 1; }

.datacotainer { display: block; background-color: rgb(255, 255, 255); margin-top: 10px; padding-bottom: 5px; }

.datacotainer.left { float: left; }

.datacotainer.right { float: right; }

.datacotainerheader { display: block; background-color: rgb(255, 255, 255); position: relative; border-bottom: 1px solid rgb(208, 208, 208); margin-bottom: 5px; }

.datacotainerheader h1, .datacotainerheader h2, .datacotainerheader h3 { padding: 12px 9px; font-size: 15px; }

.datacotainerheader h1 { text-shadow: rgb(238, 238, 238) -1px -1px 0px, rgb(238, 238, 238) 1px -1px 0px, rgb(238, 238, 238) -1px 1px 0px, rgb(238, 238, 238) 1px 1px 0px; }

.datacotainerheader h1 span { font-weight: normal; }

.datacotainerheader a { display: inline; position: absolute; float: right; background-color: rgb(255, 215, 97); font-size: 14px; padding: 7px 12px; top: -1px; right: -1px; border-top: 1px solid rgb(255, 215, 97); border-right: 1px solid rgb(255, 215, 97); color: rgb(104, 104, 104); }

.datacotainerheader a:hover { color: rgb(104, 104, 104); }

#header { width: 100%; background-color: rgb(120, 120, 120); }

#header .container { background-color: rgb(120, 120, 120); }

#header #logo { height: 50px; width: 178px; float: left; background: url("../images/common.svg") 0px 0px no-repeat rgb(120, 120, 120); }

#header #logo a { display: block; height: 100%; }

#header #menubutton { height: 50px; width: 50px; float: left; background: url("../images/common.svg") 0px -60px no-repeat; cursor: pointer; display: none; }

#header #searchbutton { height: 50px; width: 50px; float: right; background: url("../images/common.svg") -54px -60px no-repeat; cursor: pointer; display: none; }

#header #languagebutton { height: 20px; width: 50px; float: right; background: url("../images/common.svg") -110px -60px no-repeat; cursor: pointer; display: none; color: rgb(255, 255, 255); padding: 13px 0px 17px; font-size: 20px; font-weight: bold; text-align: center; }

#header #websiteswapper { padding: 8px 12px; margin: 5px; float: right; cursor: pointer; font-size: 18px; border: 1px solid rgb(238, 238, 238); color: rgb(255, 255, 255); display: none; }

#menu { font-size: 13px; color: rgb(255, 255, 255); list-style-type: none; font-weight: bold; background-color: rgb(120, 120, 120); }

#hiddenmenu { font-size: 13px; color: rgb(255, 255, 255); list-style-type: none; font-weight: normal; background-color: rgb(152, 152, 152); }

#menu li, #hiddenmenu li { float: left; display: inline; }

#menu li.current, #menu li:hover, #menu li.more:hover, #menu li.search:hover, #menu li.language:hover, #hiddenmenu li.current, #hiddenmenu li:hover { background-color: rgb(255, 215, 97); }

#menu li.current a, #menu li:hover a, #hiddenmenu li.current a, #hiddenmenu li:hover a { color: rgb(104, 104, 104); }

#menu li a, #hiddenmenu li a, #hiddenmenu li .menucloser { float: left; padding: 10px; color: rgb(255, 255, 255); text-shadow: rgb(34, 34, 34) 1px 1px; }

#menu li a .new, #hiddenmenu li a .new { float: right; padding: 3px; font-size: 10px; margin: -17px -10px -5px -15px; background-color: rgb(235, 63, 3); color: rgb(255, 255, 255); text-shadow: none; }

#hiddenmenu li a { padding: 8px 10px; text-shadow: rgb(85, 85, 85) 1px 1px; }

#hiddenmenu li .menucloser { display: none; cursor: pointer; }

